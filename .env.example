# Copy to .env and fill in values:
#   cp .env.example .env
#
# Then restart: npm run dev

# Required for Street View (Google Cloud Console → APIs & Services → Credentials)
# Enable: Street View Static API + Maps JavaScript API (billing on)
GOOGLE_MAPS_API_KEY=

# Optional: same key exposed to the Vite client (only if you render SV in-browser)
# VITE_GOOGLE_MAPS_API_KEY=

# Required for signed leaderboard submits (any long random string)
# Generate with: openssl rand -hex 32
MONK_SCORE_SECRET=change-me-to-a-long-random-string

LEADERBOARD_PORT=47448
# NODE_ENV=production

# Dev-only (never enable in production):
# ALLOW_MAPS_KEY_SCRAPE=1

# Optional WebRTC TURN for voice behind strict NATs:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
