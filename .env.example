# Copy to .env and fill in:
#   cp .env.example .env
# Then: npm run dev

# Required — Google Cloud Console → Credentials
# Enable: Maps JavaScript API + Street View Static API (billing on)
GOOGLE_MAPS_API_KEY=

# Optional client exposure (only if you render SV in-browser)
# VITE_GOOGLE_MAPS_API_KEY=

# Required — HMAC for leaderboard commits (never reuse the Maps key)
# Generate: openssl rand -hex 32
MONK_SCORE_SECRET=change-me-to-a-long-random-string

LEADERBOARD_PORT=47448

# Dev-only (never in production):
# Demo mode (default): scrape Google embed key when GOOGLE_MAPS_API_KEY is missing/invalid.
# Set to 0 to require a first-party key:
# ALLOW_MAPS_KEY_SCRAPE=0
# Leave unset (or =1) for local/Vercel demo like this cloud box.

# Optional WebRTC TURN for voice behind strict NATs:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
