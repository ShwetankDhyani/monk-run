# Copy to .env and fill in:
#   cp .env.example .env
# Then: npm run dev

# Required — Google Cloud Console → Credentials
# Enable: Maps JavaScript API + Street View Static API (billing on)
GOOGLE_MAPS_API_KEY=

# Optional client exposure (only if you render SV in-browser)
# VITE_GOOGLE_MAPS_API_KEY=

# Required — HMAC for leaderboard commits (never reuse the Maps key)
# Generate: openssl rand -hex 32
MONK_SCORE_SECRET=change-me-to-a-long-random-string

# All-time Hall of Fame / Hall of Shame (production on Vercel)
# Create Vercel KV (or Upstash Redis) and connect to the project — these are auto-injected:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Upstash naming also works: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Without KV on Vercel, records are ephemeral (/tmp). Local dev uses data/leaderboard.json.

LEADERBOARD_PORT=47448

# Demo mode (default ON): scrape Maps metadata key when GOOGLE_MAPS_API_KEY is
# missing/invalid, and render rounds via Google's public Street View embed
# (avoids Maps JS "Something went wrong" from a bad Vercel key).
# Set to 0 only when you have a billed first-party key with Maps JavaScript API:
# ALLOW_MAPS_KEY_SCRAPE=0

# Optional WebRTC TURN for voice behind strict NATs:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com","username":"u","credential":"p"}]
